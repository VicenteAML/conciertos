PORT=3000
FIREBASE_PROJECT_ID=tu-id-de-proyecto
# Ruta absoluta o relativa a backend/. No pongas la clave en frontend/public.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# Solo para desarrollo con un emulador ya iniciado:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Secreto para firmar los tokens (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Duración de la sesión (ej: 30m, 2h, 1d)
JWT_EXPIRA=2h
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contrasena